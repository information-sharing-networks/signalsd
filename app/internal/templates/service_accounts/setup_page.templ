package service_accounts

import (
	"fmt"
	"time"

	signalsd "github.com/information-sharing-networks/signalsd/app/internal/server/config"
)

type SetupPageData struct {
	ClientID     string
	ClientSecret string
	ExpiresAt    time.Time
}

// secretValidity describes how long a client secret is valid (signalsd.ClientSecretExpiry), e.g. "one year"
func secretValidity() string {
	const year = 365 * 24 * time.Hour
	switch years := int(signalsd.ClientSecretExpiry / year); {
	case signalsd.ClientSecretExpiry%year != 0:
		return fmt.Sprintf("%d days", int(signalsd.ClientSecretExpiry.Hours()/24))
	case years == 1:
		return "one year"
	default:
		return fmt.Sprintf("%d years", years)
	}
}

// htmxConfig lets htmx swap in the 400 responses that SetupError returns (by default htmx ignores 4xx responses).
const htmxConfig = `{"responseHandling":[{"code":"204","swap":false},{"code":"[234]..","swap":true},{"code":"...","swap":false,"error":true}]}`

// setupLayout is the page shared by the confirmation page and the credentials page:
// only the content below the heading and the note changes.
templ setupLayout() {
	<!DOCTYPE html>
	<html>
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<meta name="htmx-config" content={ htmxConfig }/>
			<title>Service Account Setup</title>
			<link rel="stylesheet" href="/static/css/app.css"/>
			<script src={ signalsd.HTMXScriptPath }></script>
		</head>
		<body>
			<div class="container setup-confirm">
				<h1>Service Account Setup</h1>
				<div class="info">
					The client secret is shown once only. Any secret this service account is currently using will stop working.
				</div>
				{ children... }
			</div>
			<script src="/static/js/copy-text.js"></script>
		</body>
	</html>
}

// ConfirmSetupPage is shown when the setup link is opened (GET).
//
// The credentials are only issued when the form is submitted (POST), so link scanners and chat link previews,
// which open links automatically, can't use up the one-time link or see the client secret.
//
// htmx replaces the form with the credentials (SetupCredentials) or an error (SetupError) without reloading the page,
// and disables the button while the request is in progress so a double click can't send a second request.
// Without htmx the form is submitted normally and the full SetupPage is returned.
templ ConfirmSetupPage(postURL string) {
	@setupLayout() {
		<form method="POST" hx-post={ postURL } hx-target="this" hx-swap="outerHTML" hx-disabled-elt="find button">
			<button type="submit">Show client credentials</button>
		</form>
	}
}

// SetupPage is the full page returned when the form is submitted without htmx
templ SetupPage(data SetupPageData) {
	@setupLayout() {
		@SetupCredentials(data)
	}
}

// SetupCredentials shows the client credentials (returned on its own to htmx requests, replacing the form)
templ SetupCredentials(data SetupPageData) {
	<div class="success">✓ Service account setup complete</div>
	<div class="credential">
		<div class="label">Client ID</div>
		<div class="value">
			{ data.ClientID }
			<button class="btn-copy" data-text={ data.ClientID }>Copy</button>
		</div>
	</div>
	<div class="credential">
		<div class="label">Client Secret</div>
		<div class="value">
			{ data.ClientSecret }
			<button class="btn-copy" data-text={ data.ClientSecret }>Copy</button>
		</div>
	</div>
	<div class="warning">
		<div class="warning-title">⚠️ Important</div>
		The client secret is valid for { secretValidity() }.
		It expires on { data.ExpiresAt.Format("January 2, 2006") }. Use the <code>/api/auth/service-accounts/rotate-secret</code> endpoint to get a new secret before then. The client ID does not change.
	</div>
	<h3>Next Steps:</h3>
	<p>Store the client ID and secret securely - you will need them to authenticate with the API.</p>
	<p>Access tokens are issued by calling the /oauth/token endpoint with your client_id and client_secret in the request body.</p>
	<p>When using the API include the access token as: <code>Authorization: Bearer &lt;token&gt;</code></p>
}

// SetupError replaces the form when an htmx request fails (e.g. the setup link has already been used)
templ SetupError(title, message string) {
	<div class="warning">
		<div class="warning-title">{ title }</div>
		{ message }
	</div>
}
